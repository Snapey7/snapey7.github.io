NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=https://www.impuravidamagazine.com
# Comma-separated verified account email addresses allowed to manage private releases.
CONTENT_ADMIN_EMAILS=your-login-email@example.com
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional Cloudflare R2 private storage for new subscriber vault uploads.
# When all four are present, Studio uploads to R2; otherwise it continues using Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_STANDARD_MONTHLY=price_replace-me
STRIPE_PRICE_STANDARD_YEARLY=price_replace-me
STRIPE_PRICE_IMPURA_MONTHLY=price_replace-me
STRIPE_PRICE_IMPURA_YEARLY=price_replace-me
# Physical shipping charges in GBP pence; checkout restricts the address to the chosen country.
# These example values reflect the owner's UK / Europe / international postage policy.
SHOP_SHIPPING_UK_PENCE=1000
SHOP_SHIPPING_EUROPE_PENCE=1250
SHOP_SHIPPING_INTERNATIONAL_PENCE=1500
# Legacy Verotel configuration is only needed for existing Verotel subscribers/webhooks.
VEROTEL_SHOP_ID=your-approved-verotel-shop-id
VEROTEL_SIGNATURE_KEY=your-verotel-flexpay-signature-key

# Cloudflare backend is opt-in. Enable only after the migration checks in
# cloudflare/README.md pass; keep the existing Supabase configuration for rollback.
BACKEND_PROVIDER=supabase
CLOUDFLARE_BACKEND_URL=
CLOUDFLARE_BACKEND_SECRET=
AUTH_SECRET=
AUTH_BASE_URL=
# Reuse the existing transactional email provider (currently Resend SMTP).
AUTH_SMTP_HOST=smtp.resend.com
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=resend
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Preferred for Resend: HTTPS delivery avoids SMTP port restrictions.
AUTH_RESEND_API_KEY=
STRIPE_CREATOR_JOIN_GBP_PRICE_ID=
STRIPE_CREATOR_JOIN_USD_PRICE_ID=
